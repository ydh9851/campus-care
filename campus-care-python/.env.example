# ============ CampusCare Python AI 服务配置 ============
# 复制成 .env 后填写。.env 不会提交到 Git。

# ---------- DeepSeek ----------
# 不填也能启动：会自动降级成 mock 模式（返回内置话术），方便先跑通链路
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60

# ---------- RAG ----------
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=campus_psych_faq
FAQ_DATA_PATH=./data/psych_faq.json
TOP_K=3
# 向量化方案：local_hash（默认，零依赖可离线跑） / bge（需 pip install sentence-transformers）
EMBEDDING_PROVIDER=local_hash
BGE_MODEL=BAAI/bge-small-zh-v1.5

# ---------- 会话 ----------
# 传给 LLM 的最大历史条数
HISTORY_LIMIT=10

# ---------- 服务 ----------
SERVER_PORT=8000
# Java 服务地址（用于反向健康检查，可留空）
JAVA_SERVICE_URL=http://localhost:8080
