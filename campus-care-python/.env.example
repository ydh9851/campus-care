# ============ CampusCare Python AI 服务配置 ============
# 复制成 .env 后填写。.env 不会提交到 Git。

# ---------- DeepSeek ----------
# 不填也能启动：会自动降级成 mock 模式（返回内置话术），方便先跑通链路
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 主模型失败后的备用模型（逗号分隔），留空表示不启用回退链
DEEPSEEK_FALLBACK_MODELS=
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=60
# 单次调用失败后的重试次数（不含首次）
LLM_MAX_RETRIES=2
# 重试退避基数（秒）：第 n 次重试等待 base * 2^(n-1)
LLM_RETRY_BACKOFF=0.8
# 整个调用（含所有重试）的总时间预算（秒），防止一次请求把线程占死
LLM_TOTAL_TIMEOUT=90

# ---------- RAG ----------
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION=campus_psych_faq
FAQ_DATA_PATH=./data/psych_faq.json
TOP_K=3
# 向量化方案：bge（推荐，中文语义检索） / local_hash（零依赖字面匹配，降级用）
# 选 local_hash 不需要装 sentence-transformers，但检索会退化成字面匹配
EMBEDDING_PROVIDER=bge
BGE_MODEL=BAAI/bge-small-zh-v1.5
# 检索相似度阈值。留空则按向量模型自带的默认值（哈希 0.15 / 语义 0.35），
# 一般不用改；命中太少可调低，噪声太多可调高
# RETRIEVAL_MIN_SCORE=0.35

# ---- 混合检索（BM25 + 向量 + RRF）----
# hybrid = 双路召回后融合（推荐）；vector = 仅向量（旧行为，便于对比）
RETRIEVAL_MODE=hybrid
# RRF 的 k 值：越大越压平「第 1 名 vs 第 3 名」的差距，60 是原论文经验值
RRF_K=60
# 每路召回的候选数（融合前），最终再截断到 TOP_K
RETRIEVAL_POOL=8
# BM25 分在最终相关度里的权重（只在「仅 BM25 命中」时生效）
BM25_WEIGHT=0.9
# 轻量重排开关（RRF 融合分 + 查询词覆盖率 + 标题命中）
RERANK_ENABLED=true

# ---------- 会话 ----------
# 传给 LLM 的最大历史条数
HISTORY_LIMIT=10

# ---------- 安全 ----------
# 是否在接口响应里返回免责声明（前端决定展示位置）
DISCLAIMER_ENABLED=true

# ---------- 服务 ----------
SERVER_PORT=8000
# Java 服务地址（用于反向健康检查，可留空）
JAVA_SERVICE_URL=http://localhost:8080
